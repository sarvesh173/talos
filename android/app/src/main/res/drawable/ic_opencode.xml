<?xml version="1.0" encoding="utf-8"?>
<!-- Official OpenCode Block Emblem (from anomalyco/opencode repo) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="300"
    android:viewportHeight="300">
    <group
        android:translateX="30"
        android:translateY="0">
        <!-- Inner block fill -->
        <path
            android:fillColor="#803B82F6"
            android:pathData="M180,240 H60 V120 H180 V240 Z" />
        <!-- Outer block frame -->
        <path
            android:fillColor="#FF3B82F6"
            android:fillType="evenOdd"
            android:pathData="M180,60 H60 V240 H180 V60 Z M240,300 H0 V0 H240 V300 Z" />
    </group>
</vector>
