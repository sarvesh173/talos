{
  "name": "opencode-talos-control",
  "version": "0.1.0",
  "description": "Gives OpenCode read access to the TALOS host: agents, processes, git diff, mesh",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "talos",
    "mesh",
    "tools"
  ],
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsc -b && bun build --bundle --platform=node --format=esm --external @opencode/plugin --outfile dist/plugin.js src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5",
    "talos-plugin-core": "file:../shared"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
