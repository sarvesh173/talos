{
  "name": "talos-plugin-core",
  "version": "0.1.0",
  "description": "CLI-independent core for TALOS plugins: host config, timed calls, error mapping and the tool shape",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "talos",
    "opencode",
    "claude-code",
    "plugin",
    "tools"
  ],
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
