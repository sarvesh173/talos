[Unit]
Description=TALOS Core (Rust) - agent control plane
Documentation=file:///home/kira/talos/AGENTS.md
# The overlay carries the encrypted transport; start only once it is up.
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kira/talos/crates/talos-core
Environment=PORT=8010
Environment=RUST_LOG=info,talos_core=debug
ExecStart=/home/kira/talos/crates/talos-core/target/release/talos-core
Restart=always
RestartSec=5
# Give the overlay a moment before the first health check by the agent.
ExecStartPost=/bin/sh -c 'sleep 2; /usr/bin/curl -fsS http://127.0.0.1:${PORT}/health >/dev/null || true'

[Install]
WantedBy=default.target
